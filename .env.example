# Copy this file to .env and adjust the values. .env is never committed.

# PostgreSQL warehouse
POSTGRES_USER=olist
POSTGRES_PASSWORD=change_me
POSTGRES_DB=olist
# Port exposed on the host, used by Power BI and Tableau (localhost:5432)
POSTGRES_PORT=5432

# dbt documentation site (http://localhost:8080)
DBT_DOCS_PORT=8080
