<mxfile host="app.diagrams.net"><diagram name="Olist architecture" id="olist"><mxGraphModel dx="1280" dy="660" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="660" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:26px&#x27;&gt;Olist Analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#64748B&#x27;&gt;End-to-end pipeline, rebuilt from scratch with a single &lt;code&gt;make all&lt;/code&gt;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="600" height="55" as="geometry"/></mxCell><mxCell id="wh" value="&lt;b&gt;PostgreSQL 16  ·  Docker Compose&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#336791;fillColor=#F8FAFC;fontColor=#336791;fontSize=16;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="270" y="95" width="735" height="375" as="geometry"/></mxCell><mxCell id="dbt" value="&lt;b&gt;dbt  ·  models + tests&lt;/b&gt;" style="text;html=1;align=right;fontSize=14;fontColor=#F97316;" vertex="1" parent="1"><mxGeometry x="785" y="105" width="200" height="30" as="geometry"/></mxCell><mxCell id="src" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;Olist CSV files&lt;/b&gt;&lt;br&gt;&lt;br&gt;9 files&lt;br&gt;~100k orders&lt;br&gt;2016-2018&lt;br&gt;&lt;code&gt;data/&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="145" height="170" as="geometry"/></mxCell><mxCell id="raw" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;raw&lt;/b&gt;&lt;br&gt;&lt;br&gt;9 tables&lt;br&gt;loaded as text&lt;br&gt;no transformation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="290" y="180" width="150" height="270" as="geometry"/></mxCell><mxCell id="stg" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;staging&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 stg_ views&lt;br&gt;typed, cleaned&lt;br&gt;renamed, tested" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="465" y="180" width="150" height="270" as="geometry"/></mxCell><mxCell id="int" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;intermediate&lt;/b&gt;&lt;br&gt;&lt;br&gt;2 int_ views&lt;br&gt;payments per order&lt;br&gt;latest review" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="150" height="270" as="geometry"/></mxCell><mxCell id="marts" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;marts&lt;/b&gt;&lt;br&gt;&lt;br&gt;star schema, tables&lt;br&gt;&lt;br&gt;&lt;code&gt;fct_orders&lt;/code&gt;&lt;br&gt;&lt;code&gt;fct_order_items&lt;/code&gt;&lt;br&gt;&lt;code&gt;dim_customers&lt;/code&gt;&lt;br&gt;&lt;code&gt;dim_products&lt;/code&gt;&lt;br&gt;&lt;code&gt;dim_sellers&lt;/code&gt;&lt;br&gt;&lt;code&gt;dim_dates&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="815" y="180" width="170" height="270" as="geometry"/></mxCell><mxCell id="pbi" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;Power BI&lt;/b&gt;&lt;br&gt;&lt;br&gt;dashboard on the marts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="190" height="90" as="geometry"/></mxCell><mxCell id="tab" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;Tableau&lt;/b&gt;&lt;br&gt;&lt;br&gt;workbook on the marts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1060" y="255" width="190" height="90" as="geometry"/></mxCell><mxCell id="exp" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;CSV exports&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;make export&lt;/code&gt;&lt;br&gt;&lt;code&gt;bi/exports/*.csv&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1060" y="370" width="190" height="100" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b style=&#x27;font-size:17px&#x27;&gt;GitHub Actions CI, on every pull request&lt;/b&gt;&lt;br&gt;&lt;br&gt;pre-commit (ruff, sqlfluff)  &gt;  pytest  &gt;  load CI sample  &gt;  dbt build (models + tests)  &gt;  source freshness" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;shadow=1;fontSize=13;fontColor=#334155;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="290" y="540" width="695" height="80" as="geometry"/></mxCell><mxCell id="e0" value="Python&lt;br&gt;make ingest" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#475569;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="src" target="raw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#475569;fontSize=12;fontColor=#475569;labelBackgro